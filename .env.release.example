# Copier en .env.release (non versionné) et renseigner les valeurs réelles.
# Lu par tools/release.sh pour notifier le hub après `verify` — voir notify_hub.

# URL du webhook d'import côté hub, ex. https://everyparts-api-hub.example.com/webhooks/widget-engine/import
HUB_ENGINE_IMPORT_URL=

# Doit correspondre à WIDGET_ENGINE_IMPORT_WEBHOOK_SECRET côté hub.
HUB_ENGINE_IMPORT_SECRET=
